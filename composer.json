{
    "name": "ad-pgn/touche-pas-au-klaxon",
    "description": "Application de covoiturage inter-sites",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "izniburak/router": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit"
    }
}
